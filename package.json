{
  "name": "novelbookshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "webext:run": "web-ext run --source-dir=dist --target=firefox-desktop",
    "webext:build": "web-ext build --source-dir=dist --artifacts-dir=web-ext-artifacts",
    "webext:lint": "web-ext lint --source-dir=dist"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.4",
    "@types/webextension-polyfill": "^0.12.3",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "web-ext": "^9.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "peerDependencies": {
    "@types/bun": "latest"
  }
}
